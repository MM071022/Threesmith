  {
   "name": "height",
   "type": "number",
   "default": 0.26,
   "min": 0.18,
   "max": 0.45,
   "description": "Height of the lantern without its handle, in metres (the whole lantern scales with it)."
  },
  {
   "name": "globeWidth",
   "type": "number",
   "default": 1,
   "min": 0.8,
   "max": 1.25,
   "description": "How wide the glass globe bulges, relative to the usual shape."
  },
  {
   "name": "lit",
   "type": "boolean",
   "default": true,
   "min": 0,
   "max": 1,
   "description": "The wick burns: an emissive flame inside the globe."
  },
  {
   "name": "flameHeight",
   "type": "number",
   "default": 0.034,
   "min": 0.015,
   "max": 0.05,
   "description": "Height of the flame when lit (at the default size)."
  },
  {
   "name": "handleAngle",
   "type": "number",
   "default": 0,
   "min": 0,
   "max": 90,
   "description": "How far the bail handle is folded down to the front, in degrees (0 = straight up)."
  },
  {
   "name": "color",
   "type": "integer",
   "default": 0,
   "min": 0,
   "max": 3,
   "description": "Paint of the tank and cap: 0 = red, 1 = green, 2 = black, 3 = bare galvanised steel."

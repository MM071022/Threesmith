{
 "version": 1,
 "name": "go-kart",
 "archetype": "vehicle.wheeled.go-kart",
 "description": "A sprint racing kart to CIK-FIA sizes: a low tubular steel frame with side rails, cross members, kingpins, bearing hangers and a solid rear axle with brake disc and sprocket; a moulded bucket seat, pedals, fuel tank and a steering column with a three-spoke wheel; small slick tyres on alloy rims, wider at the rear, with the front wheels steering about their kingpins; a two-stroke engine with finned cylinder, carburettor, airbox and expansion-chamber exhaust beside the seat, or an electric motor with battery packs; and plastic nose cone, front panel, side pods and rear bumper with number plates.",
 "params": [
  {
   "name": "wheelbase",
   "type": "number",
   "default": 1.04,
   "min": 0.9,
   "max": 1.07,
   "description": "Distance between the axles (CIK-FIA: 1.01-1.07 m for senior karts)."
  },
  {
   "name": "width",
   "type": "number",
   "default": 1.36,
   "min": 1.1,
   "max": 1.4,
   "description": "Overall width over the rear tyres (CIK-FIA maximum 1.4 m)."
  },
  {
   "name": "tyreRadius",
   "type": "number",
   "default": 0.14,
   "min": 0.12,
   "max": 0.15,
   "description": "Tyre radius (5 inch rims with 10-11 inch tyres are about 0.14 m)."
  },
  {
   "name": "rearTyreWidth",
   "type": "number",
   "default": 0.18,
   "min": 0.13,
   "max": 0.215,
   "description": "Width of the rear tyres; the front ones are about 0.12 m."
  },
  {
   "name": "steer",
   "type": "number",
   "default": 0,
   "min": -25,
   "max": 25,
   "description": "Steering angle of the front wheels in degrees (positive turns left); the steering wheel follows."
  },
  {
   "name": "bodywork",
   "type": "boolean",
   "default": true,
   "min": 0,
   "max": 1,
   "description": "Nose cone, front panel, side pods and rear bumper in plastic; without them it is a bare frame like an old rental kart."
  },
  {
   "name": "electric",
   "type": "boolean",
   "default": false,
   "min": 0,
   "max": 1,
   "description": "An electric kart with a battery pack and motor instead of a two-stroke engine with exhaust and airbox."
  }
 ],

{
 "version": 1,
 "name": "space-station",
 "archetype": "spacecraft.station",
 "description": "A modular space station like the ISS (109 x 73 m): a row of pressurised modules along z with ribs, end cones, handrails and windows, joined by connectors; a cross node with docking ports on both sides and a seven-window cupola; docking ports fore and aft; a long lattice truss along x on a pylon, with battens and a centre segment; solar array units at both truss ends, each with a rotary joint and a wing fore and aft (mast, two cell blankets with a grid, tip and canister), every wing a node hinged at the truss; radiator panels; and a robotic arm on a mobile base. +Y is zenith; the cupola rests on y = 0.",
 "params": [
  {
   "name": "modules",
   "type": "integer",
   "default": 5,
   "min": 2,
   "max": 9,
   "description": "Pressurised modules in a row along z."
  },
  {
   "name": "moduleLength",
   "type": "number",
   "default": 8,
   "min": 5,
   "max": 12,
   "description": "Length of each module."
  },
  {
   "name": "moduleRadius",
   "type": "number",
   "default": 2.1,
   "min": 1.5,
   "max": 2.5,
   "description": "Module radius (the ISS modules are about 4.2 m across)."
  },
  {
   "name": "trussLength",
   "type": "number",
   "default": 70,
   "min": 30,
   "max": 110,
   "description": "Length of the main truss along x (the ISS truss is 109 m)."
  },
  {
   "name": "arrays",
   "type": "integer",
   "default": 2,
   "min": 1,
   "max": 4,
   "description": "Solar array units at each end of the truss; each has a wing fore and aft."
  },
  {
   "name": "arraySpan",
   "type": "number",
   "default": 32,
   "min": 12,
   "max": 36,
   "description": "Length of each solar wing from the truss."
  },
  {
   "name": "arrayWidth",
   "type": "number",
   "default": 11,
   "min": 5,
   "max": 12,
   "description": "Width of each solar wing."
  },
  {
   "name": "radiators",
   "type": "integer",
   "default": 2,
   "min": 1,
   "max": 3,
   "description": "Radiator panels on each side of the truss."
  },
  {
   "name": "roboticArm",
   "type": "boolean",
   "default": true,
   "min": 0,
   "max": 1,
   "description": "A robotic arm on a mobile base on the truss; false leaves it folded."
  }

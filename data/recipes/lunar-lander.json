{
 "version": 1,
 "name": "lunar-lander",
 "archetype": "spacecraft.lander",
 "description": "A lunar lander, 7 m high by default like the Apollo Lunar Module (9.4 m across the gear): an octagonal descent stage in gold foil with black panels and a gimballed engine bell; three to six landing legs, each a node hinged at the top of its main strut, with secondary struts, a downlock, a dish footpad and a contact probe; a ladder and porch on the front leg; and an ascent stage: Apollo-style (crew cabin with two triangular windows, hatch, docking tunnel, aft equipment bay, four RCS quads, S-band dish, rendezvous radar and VHF antennas) or a fictional modern conical crew capsule. Hatch to +Z, footpads on y = 0.",
 "params": [
  {
   "name": "height",
   "type": "number",
   "default": 7.0,
   "min": 4,
   "max": 9,
   "description": "Height to the top of the cabin (the Apollo LM is 7.04 m); everything scales with it."
  },
  {
   "name": "legs",
   "type": "integer",
   "default": 4,
   "min": 3,
   "max": 6,
   "description": "Landing legs."
  },
  {
   "name": "legSpread",
   "type": "number",
   "default": 1.0,
   "min": 0.8,
   "max": 1.3,
   "description": "How far the footpads stand out (1 is the Apollo 9.4 m across the gear)."
  },
  {
   "name": "descentHeight",
   "type": "number",
   "default": 1.65,
   "min": 1.2,
   "max": 2.4,
   "description": "Height of the octagonal descent stage at the default size."
  },
  {
   "name": "engineSize",
   "type": "number",
   "default": 1.0,
   "min": 0.7,
   "max": 1.4,
   "description": "Size of the descent engine bell."
  },
  {
   "name": "style",
   "type": "integer",
   "default": 0,
   "min": 0,
   "max": 1,
   "description": "0 Apollo-style lunar module (gold foil descent stage, faceted ascent stage with triangular windows); 1 a fictional modern lander (white descent stage, conical crew capsule)."
  },
  {
   "name": "ladder",
   "type": "boolean",
   "default": true,
   "min": 0,
   "max": 1,
   "description": "A ladder down the front leg and a porch in front of the hatch."
  },
  {
   "name": "antennas",
   "type": "boolean",
   "default": true,
   "min": 0,
   "max": 1,
   "description": "The steerable S-band dish, rendezvous radar and VHF antennas on the ascent stage."

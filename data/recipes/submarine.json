{
 "version": 1,
 "name": "submarine",
 "archetype": "vessel.submarine",
 "description": "A submarine surfaced at the waterline (y = 0): a lathe-turned pressure hull with an elliptic bow and a long tapered stern, a deck casing with hatches, a foil-shaped sail with a bridge and five masts (two periscopes, radar, snorkel, comms) that slide up, diving planes on the bow or on the sail, four stern rudders in a cross or X layout hinged at their leading edges, and a seven-blade bronze propeller or a shrouded pump-jet. Military style adds anechoic tiling, flank sonar arrays, torpedo doors and limber holes; exploration style is yellow and white with viewports, floodlights and manipulator arms.",
 "params": [
  {
   "name": "length",
   "type": "number",
   "default": 68,
   "min": 50,
   "max": 120,
   "description": "Hull length in metres (a diesel-electric boat is about 55-80 m, a nuclear attack boat 100-115 m)."
  },
  {
   "name": "diameter",
   "type": "number",
   "default": 7.0,
   "min": 6.0,
   "max": 12.0,
   "description": "Pressure hull diameter."
  },
  {
   "name": "style",
   "type": "integer",
   "default": 0,
   "min": 0,
   "max": 1,
   "description": "0 = military: black, sonar arrays and torpedo doors; 1 = exploration: yellow and white, viewports in the bow and sail, floodlights."
  },
  {
   "name": "sailPosition",
   "type": "number",
   "default": 0.32,
   "min": 0.22,
   "max": 0.45,
   "description": "Where the sail stands, as a part of the length from the bow."
  },
  {
   "name": "rudderLayout",
   "type": "integer",
   "default": 0,
   "min": 0,
   "max": 1,
   "description": "0 = cross-shaped stern rudders, 1 = X-shaped."
  },
  {
   "name": "sailPlanes",
   "type": "boolean",
   "default": false,
   "min": 0,
   "max": 1,
   "description": "Diving planes on the sail (older and US boats) instead of on the bow."
  },
  {
   "name": "pumpJet",
   "type": "boolean",
   "default": false,
   "min": 0,
   "max": 1,
   "description": "A shrouded pump-jet instead of an open seven-blade propeller."
  },
  {
   "name": "masts",
   "type": "number",
   "default": 0.0,
   "min": 0.0,
   "max": 1.0,
   "description": "How far the periscopes and masts are raised out of the sail."

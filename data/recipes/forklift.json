{
 "version": 1,
 "name": "forklift",
 "archetype": "vehicle.wheeled.forklift",
 "description": "A counterbalance forklift truck (2.5 t class): a short chassis with fenders over large drive wheels at the front and small steered wheels under a heavy rounded counterweight at the rear, a hood with the driver's seat, a dash cowl with hydraulic levers and a steering wheel, and an overhead guard with work lights and a beacon. At the front a two-stage mast tilts about its foot; the inner mast slides up once the free lift is used, and the carriage with its load backrest and two forks lifts inside it. Electric with a charging plug or LPG with a gas bottle; optional glazing.",
 "params": [
  {
   "name": "wheelbase",
   "type": "number",
   "default": 1.65,
   "min": 1.3,
   "max": 2.0,
   "description": "Distance between the drive axle (front) and the steer axle (rear); 1.65 m is a 2.5 t truck."
  },
  {
   "name": "width",
   "type": "number",
   "default": 1.15,
   "min": 1.0,
   "max": 1.4,
   "description": "Overall width over the drive wheels."
  },
  {
   "name": "mastHeight",
   "type": "number",
   "default": 2.1,
   "min": 1.8,
   "max": 2.8,
   "description": "Height of the lowered mast."
  },
  {
   "name": "lift",
   "type": "number",
   "default": 0.0,
   "min": 0.0,
   "max": 1.0,
   "description": "How far the forks are raised: 0 = on the ground, 1 = full lift (the inner mast slides up once the free lift is used)."
  },
  {
   "name": "mastTilt",
   "type": "number",
   "default": 0,
   "min": -5,
   "max": 6,
   "description": "Mast tilt in degrees about its foot: positive tilts back towards the driver, negative forward."
  },
  {
   "name": "forkLength",
   "type": "number",
   "default": 1.07,
   "min": 0.8,
   "max": 1.6,
   "description": "Length of the fork blades."
  },
  {
   "name": "forkSpread",
   "type": "number",
   "default": 0.62,
   "min": 0.3,
   "max": 0.86,
   "description": "Distance between the fork centres."
  },
  {
   "name": "gasBottle",
   "type": "boolean",
   "default": false,
   "min": 0,
   "max": 1,
   "description": "An LPG truck with a gas bottle on the counterweight and an exhaust, instead of an electric (battery) one."
  },
  {
   "name": "enclosedCab",
   "type": "boolean",
   "default": false,
   "min": 0,
   "max": 1,
   "description": "Glass windscreen, rear window and roof panel on the overhead guard."
  }
 ],

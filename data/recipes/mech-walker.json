{
 "version": 1,
 "name": "mech-walker",
 "archetype": "machine.mech",
 "description": "A sci-fi bipedal battle mech, 9 m tall by default (real piloted walkers are 4-8.5 m, game mechs 8-14 m): an armoured torso with a tinted cockpit canopy, searchlights, heat-sink fins, exhausts and an antenna, which turns on a twist ring on the pelvis; gun arms with a rotary or single cannon and a magazine; shoulder missile pods with a grid of tubes; and digitigrade (reverse-joint) or humanoid legs with hip actuators, knee guards, pistons, ankles and three-toed feet. Torso (twist), Arm_L/R (shoulder), Elbow, Leg_L/R (hip), Knee, Ankle and Foot are nodes with their pivot on the joint axis. Faces +Z, feet on y = 0.",
 "params": [
  {
   "name": "height",
   "type": "number",
   "default": 9,
   "min": 4,
   "max": 16,
   "description": "Height to the top of the torso in metres (a Kuratas is 4 m, a game mech 8-14 m)."
  },
  {
   "name": "bulk",
   "type": "number",
   "default": 1.0,
   "min": 0.8,
   "max": 1.3,
   "description": "Width and armour thickness relative to the height."
  },
  {
   "name": "legStyle",
   "type": "integer",
   "default": 1,
   "min": 0,
   "max": 1,
   "description": "0 humanoid legs (knees forward), 1 digitigrade reverse-joint legs."
  },
  {
   "name": "legLength",
   "type": "number",
   "default": 1.0,
   "min": 0.85,
   "max": 1.2,
   "description": "Leg length relative to the height of the torso."
  },
  {
   "name": "armLength",
   "type": "number",
   "default": 1.0,
   "min": 0.8,
   "max": 1.3,
   "description": "Length of the gun arms."
  },
  {
   "name": "barrels",
   "type": "integer",
   "default": 3,
   "min": 1,
   "max": 6,
   "description": "Barrels on each gun arm: 1 is a single cannon, more make a rotary cannon."
  },
  {
   "name": "missileRows",
   "type": "integer",
   "default": 3,
   "min": 2,
   "max": 5,
   "description": "Rows (and columns) of missile tubes in each shoulder pod."
  },
  {
   "name": "weaponPods",
   "type": "boolean",
   "default": true,
   "min": 0,
   "max": 1,
   "description": "Missile pods on the shoulders; false leaves low armour covers on the mounts."
  }

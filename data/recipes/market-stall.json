  {
   "name": "width",
   "type": "number",
   "default": 3,
   "min": 2,
   "max": 5,
   "description": "Width of the stall along the counter (x) in metres."
  },
  {
   "name": "depth",
   "type": "number",
   "default": 1.8,
   "min": 1.3,
   "max": 2.5,
   "description": "Depth from back to front (z)."
  },
  {
   "name": "height",
   "type": "number",
   "default": 2.2,
   "min": 2,
   "max": 2.6,
   "description": "Height of the front beam (the low edge of the awning)."
  },
  {
   "name": "slope",
   "type": "number",
   "default": 0.4,
   "min": 0.15,
   "max": 0.8,
   "description": "How much higher the back beam is than the front beam."
  },
  {
   "name": "counterHeight",
   "type": "number",
   "default": 0.85,
   "min": 0.75,
   "max": 1,
   "description": "Height of the counter top."
  },
  {
   "name": "awningColour",
   "type": "integer",
   "default": 0,
   "min": 0,
   "max": 3,
   "description": "Colour of the stripes (with white): 0 red, 1 green, 2 blue, 3 orange."
  },
  {
   "name": "crates",
   "type": "integer",
   "default": 4,
   "min": 1,
   "max": 9,
   "description": "Crates of produce on the counter (apples, oranges and greens in turn)."
  },
  {
   "name": "valance",
   "type": "boolean",
   "default": true,
   "min": 0,
   "max": 1,
   "description": "The scalloped flap along the front of the awning."

{
 "version": 1,
 "name": "market-stall",
 "archetype": "building.market-stall",
 "description": "A wooden market stall with its counter facing +Z: four posts on feet with side rails, a front beam and a higher back beam carrying a sloping striped canvas awning that overhangs the front with a scalloped valance, a planked counter with a front apron, bearers and a lower shelf, crates of apples, oranges and greens on the counter, a stack of spare crates underneath, and a chalkboard sign on the apron.",

{
 "version": 1,
 "name": "grandfather-clock",
 "archetype": "prop.grandfather-clock",
 "description": "A mahogany longcase (grandfather) clock facing +Z: a plinth on bracket feet, a trunk with a hinged, glazed door, a hood with columns, a glazed square dial with a chapter ring, numerals and brass spandrels, hour and minute hands that turn about z at the dial centre (set by hour and minute), a seconds pendulum (0.994 m) whose pivot is its suspension, brass weights on chains, and a flat cornice or an arched bonnet with finials.",
 "params": [
  {
   "name": "height",
   "type": "number",
   "default": 2.1,
   "min": 1.8,
   "max": 2.5,
   "description": "Height of the clock to the top of the cornice, in metres (a bonnet's finials rise about 0.15 m above it)."
  },
  {
   "name": "width",
   "type": "number",
   "default": 0.5,
   "min": 0.4,
   "max": 0.62,
   "description": "Width of the hood (the trunk is narrower, the plinth a little wider)."
  },
  {
   "name": "depth",
   "type": "number",
   "default": 0.3,
   "min": 0.24,
   "max": 0.38,
   "description": "Depth of the hood."
  },
  {
   "name": "hoodStyle",
   "type": "integer",
   "default": 1,
   "min": 0,
   "max": 1,
   "description": "0 = flat top with a cornice, 1 = arched bonnet with a broken pediment and finials."
  },
  {
   "name": "hour",
   "type": "number",
   "default": 10,
   "min": 0,
   "max": 11.99,
   "description": "Time shown: the hour (0-12)."
  },
  {
   "name": "minute",
   "type": "number",
   "default": 10,
   "min": 0,
   "max": 59.99,
   "description": "Time shown: the minutes."
  },
  {
   "name": "swing",
   "type": "number",
   "default": 0,
   "min": -6,
   "max": 6,
   "description": "Pendulum angle in degrees (animate it with rotation.z = A * sin(pi * t))."
  },
  {
   "name": "doorAngle",
   "type": "number",
   "default": 0,
   "min": 0,
   "max": 100,
   "description": "How far the trunk door is open, in degrees (hinged on its left edge)."
  },
  {
   "name": "weights",
   "type": "integer",
   "default": 3,

  {
   "name": "length",
   "type": "number",
   "default": 11,
   "min": 8,
   "max": 16,
   "description": "Length of the front (x) in metres."
  },
  {
   "name": "depth",
   "type": "number",
   "default": 7,
   "min": 6,
   "max": 10,
   "description": "Depth of the ground floor (z)."
  },
  {
   "name": "floors",
   "type": "integer",
   "default": 2,
   "min": 1,
   "max": 3,
   "description": "Storeys: the stone ground floor plus timber-framed upper storeys."
  },
  {
   "name": "jetty",
   "type": "number",
   "default": 0.45,
   "min": 0.2,
   "max": 0.8,
   "description": "How far the upper storeys overhang front and back."
  },
  {
   "name": "roofPitch",
   "type": "number",
   "default": 52,
   "min": 40,
   "max": 62,
   "description": "Pitch of the roof in degrees."
  },
  {
   "name": "roofStyle",
   "type": "integer",
   "default": 0,
   "min": 0,
   "max": 1,
   "description": "0 = clay tiles, 1 = thatch."

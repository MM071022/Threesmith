{
 "version": 1,
 "name": "tram",
 "archetype": "vehicle.rail.tram",
 "description": "A low-floor articulated city tram: 3 to 7 carbody sections with rounded roofs, tinted window bands with framed panes, a double sliding door per side on every section, livery stripes, roof coolers and optional side skirts, joined by bellows articulations; a raked glazed cab at each end with headlights, tail lights, a destination display, wiper and mirror arms; motor bogies under every other section (and the last), with frames, springs and flanged wheels on standard gauge, and a single-arm pantograph that can be raised to the wire.",
 "params": [
  {
   "name": "sections",
   "type": "integer",
   "default": 5,
   "min": 3,
   "max": 7,
   "description": "Carbody sections; about half carry a bogie, the others hang between them (5 sections is about 33 m)."
  },
  {
   "name": "sectionLength",
   "type": "number",
   "default": 6.0,
   "min": 4.5,
   "max": 7.5,
   "description": "Length of one section in metres."
  },
  {
   "name": "width",
   "type": "number",
   "default": 2.4,
   "min": 2.3,
   "max": 2.65,
   "description": "Body width (2.4 m and 2.65 m are the common sizes)."
  },
  {
   "name": "height",
   "type": "number",
   "default": 3.3,
   "min": 3.1,
   "max": 3.5,
   "description": "Roof height above the rail."
  },
  {
   "name": "pantograph",
   "type": "number",
   "default": 0.0,
   "min": 0.0,
   "max": 1.0,
   "description": "How far the pantograph is raised: 0 = down on the roof, 1 = up to an overhead wire about 2 m above it."
  },
  {
   "name": "skirts",
   "type": "boolean",
   "default": true,
   "min": 0,
   "max": 1,
   "description": "Side skirts that hide the wheels, as on most modern low-floor trams."
  },
  {
   "name": "windowsPerSection",
   "type": "integer",
   "default": 2,
   "min": 1,
   "max": 3,
   "description": "Side windows on each side of a section, between the doors."
  }
 ],
 "materials": {
  "body_white": {
   "color": [
    0.8,
    0.8,
    0.78
   ],
   "metallic": 0.25,
   "roughness": 0.3
  },
  "livery_red": {

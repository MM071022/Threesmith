  {
   "name": "height",
   "type": "number",
   "default": 1.45,
   "min": 1.1,
   "max": 1.6,
   "description": "Height at the withers in metres (a Holstein is about 1.45-1.5, a Jersey about 1.2)."
  },
  {
   "name": "length",
   "type": "number",
   "default": 1,
   "min": 0.85,
   "max": 1.2,
   "description": "Body length relative to a Holstein."
  },
  {
   "name": "build",
   "type": "number",
   "default": 1,
   "min": 0.8,
   "max": 1.25,
   "description": "Width of the body (0.8 a lean dairy cow, 1.25 a beef breed)."
  },
  {
   "name": "legs",

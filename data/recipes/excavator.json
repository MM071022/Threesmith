{
 "version": 1,
 "name": "excavator",
 "archetype": "vehicle.tracked.excavator",
 "description": "A 20 t class crawler excavator: an undercarriage with two steel tracks with grousers, idlers, drive sprockets, track rollers and carrier rollers on track frames, a car body and a slewing ring; an upper structure with a rounded counterweight, engine hood with grilles and exhaust stack, fuel tank, toolbox and handrail, and a glazed operator's cab with seat, consoles and work lights on the left; and the digging arm: a banana boom, a stick and a toothed bucket, each pivoting on its pin, posed by inverse kinematics from where the bucket should be, with boom, stick and bucket cylinders that follow the pose. Optional dozer blade.",
 "params": [
  {
   "name": "width",
   "type": "number",
   "default": 2.98,
   "min": 2.5,
   "max": 3.3,
   "description": "Width over the tracks (a 20 t machine with 600 mm shoes is about 2.98 m)."
  },
  {
   "name": "trackLength",
   "type": "number",
   "default": 4.45,
   "min": 3.6,
   "max": 5.0,
   "description": "Overall length of a track."
  },
  {
   "name": "boomLength",
   "type": "number",
   "default": 5.7,
   "min": 4.6,
   "max": 6.5,
   "description": "Boom length from the foot pin to the stick pin."
  },
  {
   "name": "stickLength",
   "type": "number",
   "default": 2.9,
   "min": 2.2,
   "max": 3.4,
   "description": "Stick (arm) length from the boom pin to the bucket pin."
  },
  {
   "name": "reach",
   "type": "number",
   "default": 6.2,
   "min": 5.0,
   "max": 8.0,
   "description": "Where the bucket pin is, forward of the slewing centre; boom and stick angles follow from it (clamped to what the arm can reach)."
  },
  {
   "name": "bucketHeight",
   "type": "number",
   "default": 1.3,
   "min": 1.3,
   "max": 4.5,
   "description": "Height of the bucket pin above the ground; 1.3 m rests the teeth on the ground."
  },
  {
   "name": "bucketAngle",
   "type": "number",
   "default": -95,
   "min": -150,
   "max": -30,
   "description": "Direction of the bucket from its pin to the teeth, in degrees from horizontal: -90 points the teeth down, -150 curls them in."
  },
  {
   "name": "slew",
   "type": "number",
   "default": 0,
   "min": -35,
   "max": 35,
   "description": "Rotation of the upper structure about the slewing ring, in degrees."
  },
  {
   "name": "blade",
   "type": "boolean",
   "default": false,
   "min": 0,
   "max": 1,
   "description": "A dozer blade at the front of the undercarriage."
  }

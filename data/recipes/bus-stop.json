{
 "version": 1,
 "name": "bus-stop",
 "archetype": "infrastructure.bus-stop",
 "description": "A roadside bus shelter open to the road at +Z: a metal frame of back and front posts with rails, glass back panes with a white manifestation band, optional glass end panes and a lit advertising case at one end, a flat canopy with fascias and an LED strip, a cantilever bench with wooden slats and a backrest, a timetable in the shelter, and a separate bus stop pole beside it with a round flag sign and a timetable case.",
 "params": [
  {
   "name": "width",
   "type": "number",
   "default": 3.6,
   "min": 2.4,
   "max": 6,
   "description": "Length of the shelter along the kerb (x) in metres."
  },
  {
   "name": "depth",
   "type": "number",
   "default": 1.4,
   "min": 1,
   "max": 2,
   "description": "Depth of the shelter (z)."
  },
  {
   "name": "height",
   "type": "number",
   "default": 2.5,
   "min": 2.2,
   "max": 3,
   "description": "Height of the canopy."
  },
  {
   "name": "bays",
   "type": "integer",
   "default": 3,
   "min": 2,
   "max": 5,
   "description": "Number of glass bays in the back wall."
  },
  {
   "name": "sides",
   "type": "integer",
   "default": 1,
   "min": 0,
   "max": 2,
   "description": "Glass end panes: 0 none, 1 at the +x end, 2 at both ends (the advertising case takes the -x end when it is on)."
  },
  {
   "name": "advert",
   "type": "boolean",
   "default": true,
   "min": 0,
   "max": 1,
   "description": "A lit advertising case at the -x end."
  },
  {
   "name": "benchLength",
   "type": "number",
   "default": 1.8,
   "min": 0.8,
   "max": 3,
   "description": "Length of the bench (kept inside the shelter)."
  },
  {
   "name": "frameColour",
   "type": "integer",
   "default": 0,
   "min": 0,
   "max": 2,
   "description": "Frame colour: 0 silver aluminium, 1 anthracite, 2 green."
  },
  {
   "name": "signHeight",
   "type": "number",
   "default": 2.8,
   "min": 2.2,
   "max": 3.4,
   "description": "Height of the bus stop pole."
  }

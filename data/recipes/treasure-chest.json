{
 "version": 1,
 "name": "treasure-chest",
 "archetype": "prop.treasure-chest",
 "description": "A pirate treasure chest with its lock facing +Z: a body of oak planks lined with red velvet, iron bands with rivets and corner fittings, iron drop handles on the ends, a brass lock plate with a keyhole, and a barrel-vaulted (or low) lid on two back hinges whose pivot is the hinge line, so it opens by turning about x; it can be filled with gold coins.",

   "min": 0.25,
   "max": 0.6,
   "description": "Height of the body without the lid."
  },
  {
   "name": "lidStyle",
   "type": "integer",
   "default": 1,
   "min": 0,
   "max": 1,
   "description": "0 = a low, slightly domed lid, 1 = a barrel-vaulted lid."
  },
  {
   "name": "openAngle",
   "type": "number",
   "default": 0,
   "min": 0,
   "max": 100,
   "description": "How far the lid is open, in degrees (it turns about its back hinge line)."
  },
  {
   "name": "bands",
   "type": "integer",
   "default": 2,
   "min": 1,
   "max": 4,
   "description": "Number of iron bands over the body and the lid."
  },
  {

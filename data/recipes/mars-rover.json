{
 "version": 1,
 "name": "mars-rover",
 "archetype": "spacecraft.rover",
 "description": "A six-wheeled Mars rover the size of Curiosity (3.0 x 2.8 x 2.2 m): a white warm electronics box with a deck, gold front panel and hazard cameras; rocker-bogie suspension on each side (Rocker_L/R pivoting on the body, linked by a differential bar, each carrying a Bogie) with six aluminium wheels with spokes and grousers, the four corner wheels on steering nodes; a remote sensing mast with Mastcam, Navcam and ChemCam on a pan head; a robotic arm (stowed or deployed) with a turret holding a drill, hand lens and spectrometer; high-gain, UHF and low-gain antennas; and either an RTG with fins at the back or solar panel wings. Front +Z, wheels on y = 0.",
 "params": [
  {
   "name": "length",
   "type": "number",
   "default": 3.0,
   "min": 1.5,
   "max": 3.5,
   "description": "Rover length in metres (Curiosity is 3.0 m, Spirit 1.6 m); everything scales with it."
  },
  {
   "name": "wheelDiameter",
   "type": "number",
   "default": 0.52,
   "min": 0.4,
   "max": 0.65,
   "description": "Wheel diameter at the default length."
  },
  {
   "name": "wheelWidth",
   "type": "number",
   "default": 0.4,
   "min": 0.28,
   "max": 0.5,
   "description": "Wheel width at the default length."
  },
  {
   "name": "track",
   "type": "number",
   "default": 1.0,
   "min": 0.85,
   "max": 1.15,
   "description": "Width between the wheels relative to the Curiosity track."
  },
  {
   "name": "mastHeight",
   "type": "number",
   "default": 2.2,
   "min": 1.6,
   "max": 2.5,
   "description": "Height of the camera head at the default length."
  },
  {
   "name": "power",
   "type": "integer",
   "default": 0,
   "min": 0,
   "max": 1,
   "description": "0 a radioisotope generator (RTG) at the back like Curiosity, 1 solar panel wings on the deck like Spirit and Opportunity."
  },
  {
   "name": "armDeployed",
   "type": "boolean",
   "default": false,
   "min": 0,
   "max": 1,
   "description": "The robotic arm reaches forward to the ground; false keeps it stowed against the front."
  }
 ],

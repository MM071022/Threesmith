{
 "version": 1,
 "name": "robot",
 "archetype": "creature.humanoid",
 "description": "A friendly humanoid service robot, about 1.25 m tall (between a Pepper and an ASIMO): a white moulded torso with a status light, a chest panel and a battery pack, a rounded head with a dark screen face showing glowing eyes and a smile, ear pods and an antenna, arms with shoulder, elbow and wrist joints and jointed fingers and a thumb, and legs with hip, knee and ankle joints. Head (neck), Arm_L/R (shoulder), Elbow, Hand, Leg_L/R (hip), Knee and Foot are nodes with their pivot on the joint axis. Three accent colours. Faces +Z, feet on y = 0.",
 "params": [
  {
   "name": "height",
   "type": "number",
   "default": 1.25,
   "min": 0.8,
   "max": 1.8,
   "description": "Standing height in metres (a Pepper is 1.2 m, an ASIMO 1.3 m)."
  },
  {
   "name": "build",
   "type": "number",
   "default": 1.0,
   "min": 0.8,
   "max": 1.3,
   "description": "Bulk of the body and limbs: below 1 is slim, above is sturdy."
  },
  {
   "name": "headSize",
   "type": "number",
   "default": 1.0,
   "min": 0.8,
   "max": 1.3,
   "description": "Head size relative to the body; a bigger head reads friendlier."
  },
  {
   "name": "armLength",
   "type": "number",
   "default": 1.0,
   "min": 0.85,
   "max": 1.2,
   "description": "Arm length relative to the body."
  },
  {
   "name": "legLength",
   "type": "number",
   "default": 1.0,
   "min": 0.8,
   "max": 1.2,
   "description": "Leg length relative to the body (short legs make it stockier)."
  },
  {
   "name": "fingers",
   "type": "integer",
   "default": 3,
   "min": 2,
   "max": 4,
   "description": "Fingers on each hand, besides the thumb."
  },
  {
   "name": "scheme",
   "type": "integer",
   "default": 0,
   "min": 0,
   "max": 2,
   "description": "Accent colour of the shoulder caps, ear pods, knee caps and chest panel, and the colour of the face: 0 blue, 1 orange, 2 green."
  },
  {
   "name": "antenna",
   "type": "boolean",
   "default": true,
   "min": 0,
   "max": 1,
   "description": "A short antenna with a light on top of the head; false leaves a flush cap."
  }

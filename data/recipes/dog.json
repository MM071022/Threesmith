{
 "version": 1,
 "name": "dog",
 "archetype": "creature.quadruped",
 "description": "A medium dog in the proportions of a labrador (a golden coat, darker ears and muzzle): a lofted body with a deep chest and a tucked-up belly, an arched neck with a collar and tag, a head with a stop, a muzzle, a black nose, eyes and ears that range from pricked to floppy, four legs with elbows, hocks that bend backwards and paws, and a tail that hangs or curls over the back. Legs, knees, hocks, head, ears and tail are nodes with their pivot at the joint, so it can be animated. Breed-like proportions (length, build, leg length, snout) are parameters. Head towards +Z, paws on y = 0.",
 "params": [
  {
   "name": "height",
   "type": "number",
   "default": 0.57,
   "min": 0.25,
   "max": 0.9,
   "description": "Height at the withers in metres (a labrador is 0.55-0.62, a beagle 0.36, a great dane 0.8)."
  },
  {
   "name": "length",
   "type": "number",
   "default": 1,
   "min": 0.8,
   "max": 1.35,
   "description": "Body length relative to a labrador (1.3 is a dachshund-like long back)."
  },
  {
   "name": "build",
   "type": "number",
   "default": 1,
   "min": 0.7,
   "max": 1.4,
   "description": "Width of the body and legs (0.7 a greyhound, 1.4 a bulldog)."
  },
  {
   "name": "legs",
   "type": "number",
   "default": 1,
   "min": 0.55,
   "max": 1.3,
   "description": "Leg length relative to a labrador (0.55 a corgi or dachshund, 1.3 a greyhound)."
  },
  {
   "name": "snout",
   "type": "number",
   "default": 1,
   "min": 0.4,
   "max": 1.7,
   "description": "Muzzle length (0.4 a pug or bulldog, 1.7 a collie or greyhound)."
  },
  {
   "name": "earDroop",
   "type": "number",
   "default": 1,
   "min": 0,
   "max": 1,
   "description": "0 pricked ears (a shepherd or husky), 1 floppy ears (a labrador or beagle)."
  },
  {
   "name": "tailStyle",
   "type": "integer",
   "default": 1,
   "min": 1,
   "max": 2,
   "description": "1 a hanging tail (a labrador), 2 curled up over the back (a husky or spitz)."

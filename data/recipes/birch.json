  "birch_leaf": {
   "color": [
    0.022,
    0.06,
    0.008,
    1
   ],
   "metallic": 0,
   "roughness": 0.8,
   "texture": "leaf"
  },
  "birch_leaf_light": {
   "color": [
    0.04,
    0.095,
    0.012,
    1
   ],
   "metallic": 0,
   "roughness": 0.78,
   "texture": "leaf"
  }
 },

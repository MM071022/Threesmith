            "reach": "$cw * 0.5 * (0.72 + 0.28 * (abs(sin($seed * 12.9898 + $i * 4.1414 + 7 * 78.233) * 43758.5453) % 1)) * (1.25 - 0.75 * (0.3 + 0.62 * ($i + (abs(sin($seed * 12.9898 + $i * 4.1414 + 6 * 78.233) * 43758.5453) % 1)) / $n))",
            "lift": "$top * (0.12 + 0.1 * (abs(sin($seed * 12.9898 + $i * 4.1414 + 8 * 78.233) * 43758.5453) % 1))",
            "br": "$tr * (0.42 - 0.2 * (0.3 + 0.62 * ($i + (abs(sin($seed * 12.9898 + $i * 4.1414 + 6 * 78.233) * 43758.5453) % 1)) / $n))",
            "droop": "$top * 0.12 * $weeping",
            "ls": "$cw * (0.11 + 0.04 * (abs(sin($seed * 12.9898 + $i * 4.1414 + 9 * 78.233) * 43758.5453) % 1))"

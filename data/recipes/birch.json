               "$ls * 0.1"
              ],
              [
               "$reach * 1.15",
               "$lift - $droop - $ls * 0.9",
               "$ls * 0.15"
              ]
             ],
             "radii": [
              "$br * 0.24",
              "$br * 0.15",
              "$br * 0.08"
             ]
            },
            {
             "name": "Leaves",
             "shape": "ellipsoid",
             "material": "birch_leaf",
             "segments": 16,
             "lumps": 0.35,
             "seed": "$seed + $i * 7 + 1",

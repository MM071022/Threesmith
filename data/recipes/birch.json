{
 "version": 1,
 "name": "birch",
 "archetype": "plant.tree.broadleaf",
 "description": "A silver birch: a slender, slightly leaning white trunk with dark horizontal lenticel marks and a dark, fissured foot, ascending limbs that end in hanging twigs, and a light, open, oval crown of small clusters in two fresh greens. The seed sets the marks and the branch layout; how much the twigs weep is a parameter.",
 "params": [
  {
   "name": "height",
   "type": "number",
   "default": 14,
   "min": 4,
   "max": 25,
   "description": "Total height in metres (a silver birch is usually 15-25 m)."
  },
  {
   "name": "crownWidth",
   "type": "number",
   "default": 5,
   "min": 2,
   "max": 10,
   "description": "Width of the crown in metres."
  },
  {
   "name": "trunkRadius",
   "type": "number",
   "default": 0.15,
   "min": 0.06,
   "max": 0.4,
   "description": "Trunk radius at head height."
  },
  {
   "name": "branches",
   "type": "integer",
   "default": 7,
   "min": 4,
   "max": 12,
   "description": "Number of main limbs."
  },
  {
   "name": "weeping",
   "type": "number",
   "default": 0.5,
   "min": 0,
   "max": 1,
   "description": "How far the twigs hang (silver birch weeps, downy birch hardly)."
  },
  {
   "name": "lean",
   "type": "number",
   "default": 0.3,
   "min": -1,
   "max": 1,
   "description": "Sideways lean of the trunk top in metres."
  },
  {
   "name": "marks",
   "type": "integer",
   "default": 22,
   "min": 6,
   "max": 40,
   "description": "Number of dark marks on the trunk."
  },
  {
   "name": "seed",
   "type": "integer",
   "default": 4,
   "min": 1,
   "max": 999,
   "description": "Seed for the marks and the limbs."
  }
 ],
 "materials": {
  "birch_bark": {
   "color": [
    0.6,
    0.58,
    0.54,
    1
   ],
   "metallic": 0,
   "roughness": 0.7,
   "texture": "plaster"
  },
  "birch_base": {
   "color": [
    0.06,
    0.05,
    0.045,
    1
   ],
   "metallic": 0,
   "roughness": 0.95,
   "texture": "bark"
  },
  "birch_mark": {
   "color": [
    0.03,
    0.028,
    0.026,
    1
   ],
   "metallic": 0,
   "roughness": 0.9
  },

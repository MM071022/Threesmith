         "rotate": [
          0,
          "-($seed * 53 + $i * 360 / $n + 140 * (abs(sin($seed * 12.9898 + $i * 4.1414 + 1 * 78.233) * 43758.5453) % 1))",
          0
         ],
         "children": [
          {
           "name": "Shift",
           "at": [
            "$lean * pow(0.1 + 0.68 * ($i + (abs(sin($seed * 12.9898 + $i * 4.1414 + 2 * 78.233) * 43758.5453) % 1)) / $n, 2)",
            0,
            0
           ],
           "rotate": [

             "shape": "ellipsoid",
             "material": "birch_mark",
             "segments": 12,
             "vars": {
              "rr": "($tr * (1.3 - 1.05 * clamp(($top * (0.1 + 0.68 * ($i + (abs(sin($seed * 12.9898 + $i * 4.1414 + 2 * 78.233) * 43758.5453) % 1)) / $n)) / $top, 0, 1)))"
             },
             "at": [
              0,
              0,
              "$rr * 0.86"
             ],
             "radii": [
              "$rr * (0.55 + 0.45 * (abs(sin($seed * 12.9898 + $i * 4.1414 + 3 * 78.233) * 43758.5453) % 1))",
              "$rr * (0.07 + 0.1 * (abs(sin($seed * 12.9898 + $i * 4.1414 + 4 * 78.233) * 43758.5453) % 1))",

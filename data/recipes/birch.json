      ],
      [
       "$lean * 0.01",
       "$top * 0.1",
       0
      ],
      [
       "$lean * 0.09",
       "$top * 0.3",
       0
      ],
      [
       "$lean * 0.25",
       "$top * 0.5",
       0
      ],
      [
       "$lean * 0.49",
       "$top * 0.7",
       0
      ],
      [
       "$lean * 0.7225",
       "$top * 0.85",
       0
      ],
      [

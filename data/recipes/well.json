   "max": 0.95,
   "description": "Outer radius of the wall in metres."
  },
  {
   "name": "wallHeight",
   "type": "number",
   "default": 0.8,
   "min": 0.5,
   "max": 1.1,
   "description": "Height of the wall up to the coping."
  },
  {

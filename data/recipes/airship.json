{
 "version": 1,
 "name": "airship",
 "archetype": "aircraft.lighter-than-air.airship",
 "description": "An airship moored on the ground, 75 m long and 15 m across by default (a Zeppelin NT is 75 m): a streamlined envelope with a blunt nose, a long tapering tail, a mooring cone and four X-tail fins with hinged ruddervators. Style 0 is a classic silver zeppelin with a streamlined control car (window bands, windscreen, landing wheel) and engine cars on struts with pusher propellers; style 1 is steampunk: a canvas envelope with brass bands and a wooden boat gondola on ropes with a cabin, portholes, a funnel, brass rails and outrigger engines with wooden propellers. Nose +Z, resting on y = 0.",
 "params": [
  {
   "name": "length",
   "type": "number",
   "default": 75,
   "min": 30,
   "max": 150,
   "description": "Envelope length in metres (a Zeppelin NT is 75 m)."
  },
  {
   "name": "diameter",
   "type": "number",
   "default": 15,
   "min": 7,
   "max": 30,
   "description": "Largest envelope diameter."
  },
  {
   "name": "style",
   "type": "integer",
   "default": 0,
   "min": 0,
   "max": 1,
   "description": "0 classic silver zeppelin with a streamlined control car and engine cars, 1 steampunk: canvas envelope with brass bands, a wooden boat gondola on ropes and wooden propellers."
  },
  {
   "name": "engines",
   "type": "integer",
   "default": 2,
   "min": 1,
   "max": 3,
   "description": "Engines (each with a propeller) on each side."
  },
  {
   "name": "finSize",
   "type": "number",
   "default": 1.0,
   "min": 0.7,
   "max": 1.4,
   "description": "Size of the four tail fins relative to the diameter."
  },
  {
   "name": "gondolaLength",
   "type": "number",
   "default": 0.17,
   "min": 0.1,
   "max": 0.25,
   "description": "Gondola length as a share of the envelope length."

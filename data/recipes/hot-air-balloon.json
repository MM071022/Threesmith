{
 "version": 1,
 "name": "hot-air-balloon",
 "archetype": "aircraft.lighter-than-air.hot-air-balloon",
 "description": "A hot air balloon at rest on its basket, about 22 m high and 16 m across (a 2,500 m3 sport balloon): a natural teardrop envelope of 24 gores with every other gore in the stripe colour, an optional equator band, a crown vent and a fabric skirt at the mouth; eight load cables to a steel load frame on four rods with padded sleeves; a double propane burner with coils, valves and pilot lights; and a square wicker basket with a leather rim, handles, skids and propane tanks. Three colour schemes. Stands on y = 0, the envelope round the y axis.",
 "params": [
  {
   "name": "envelopeHeight",
   "type": "number",
   "default": 18,
   "min": 12,
   "max": 26,
   "description": "Height of the envelope from the mouth to the crown."
  },
  {
   "name": "diameter",
   "type": "number",
   "default": 16,
   "min": 11,
   "max": 22,
   "description": "Widest diameter of the envelope."
  },
  {
   "name": "gores",
   "type": "integer",
   "default": 24,
   "min": 16,
   "max": 32,
   "description": "Vertical panels (gores) around the envelope; every other one carries the stripe colour."
  },
  {
   "name": "scheme",
   "type": "integer",
   "default": 0,
   "min": 0,
   "max": 2,
   "description": "Colours of the envelope and its stripes: 0 red and yellow, 1 blue and white, 2 rainbow orange and purple."
  },
  {
   "name": "basketWidth",
   "type": "number",
   "default": 1.4,
   "min": 1.0,
   "max": 2.2,
   "description": "Width of the square wicker basket."
  },
  {
   "name": "basketHeight",
   "type": "number",
   "default": 1.1,
   "min": 0.95,
   "max": 1.25,
   "description": "Height of the basket wall."
  },
  {
   "name": "tanks",
   "type": "integer",
   "default": 3,
   "min": 1,
   "max": 4,
   "description": "Propane tanks standing in the basket."
  },
  {
   "name": "equatorBand",
   "type": "boolean",
   "default": true,
   "min": 0,
   "max": 1,
   "description": "A band of the stripe colour round the widest part of the envelope."
  }
 ],

   "name": "length",
   "type": "number",
   "default": 3.8,
   "min": 1.9,
   "max": 12,
   "description": "Length from the door to the back (z) in metres."
  },
  {
   "name": "width",
   "type": "number",
   "default": 2.5,
   "min": 1.9,
   "max": 4.5,
   "description": "Width (x)."
  },
  {
   "name": "eaveHeight",
   "type": "number",
   "default": 1.6,
   "min": 1.4,
   "max": 2.4,
   "description": "Height of the eaves."
  },
  {
   "name": "roofPitch",
   "type": "number",
   "default": 28,
   "min": 18,
   "max": 40,
   "description": "Pitch of the roof in degrees (the arched roof rises as much)."
  },
  {
   "name": "roofStyle",
   "type": "integer",
   "default": 0,
   "min": 0,
   "max": 1,
   "description": "0 = a gable roof, 1 = an arched roof."
  },
  {
   "name": "baseHeight",
   "type": "number",
   "default": 0.3,
   "min": 0.05,
   "max": 0.7,
   "description": "Height of the brick base wall."
  },
  {
   "name": "vents",
   "type": "integer",
   "default": 1,
   "min": 1,
   "max": 4,
   "description": "Roof vents on the +x side (they fit the length)."
  },
  {
   "name": "ventOpen",
   "type": "number",
   "default": 15,
   "min": 0,
   "max": 45,
   "description": "How far the vents are open, in degrees."
  },
  {
   "name": "doorOpen",
   "type": "number",
   "default": 0,
   "min": 0,
   "max": 1,
   "description": "0 = door closed, 1 = slid fully open to +x."

{
 "version": 1,
 "name": "deer",
 "archetype": "creature.quadruped",
 "description": "A deer in the proportions of a red deer stag: a slender lofted body with a white rump patch, a long upright neck, a narrow head with big ears, eyes, a dark nose and a white chin, a pale belly, branched antlers whose beam sweeps up and out with a row of forward-pointing tines (count and size are parameters, or none for a hind), long thin legs with knees, hocks that bend backwards and small hooves, a short tail, and optional white spots like a sika or fallow deer. Legs, knees, hocks, head, ears and tail are nodes with their pivot at the joint. Head towards +Z, hooves on y = 0.",
 "params": [
  {
   "name": "height",
   "type": "number",
   "default": 1.15,
   "min": 0.6,
   "max": 1.5,
   "description": "Height at the shoulder in metres (roe deer 0.7, white-tailed 0.9, red deer stag 1.2, wapiti 1.5)."
  },
  {
   "name": "length",
   "type": "number",
   "default": 1,
   "min": 0.85,
   "max": 1.2,
   "description": "Body length relative to a red deer."
  },
  {
   "name": "build",
   "type": "number",
   "default": 1,
   "min": 0.8,
   "max": 1.25,
   "description": "Width of the body."
  },
  {
   "name": "legs",
   "type": "number",
   "default": 1,
   "min": 0.85,
   "max": 1.2,
   "description": "Leg length relative to a red deer."
  },
  {
   "name": "antlers",
   "type": "boolean",
   "default": true,
   "min": 0,
   "max": 1,
   "description": "Antlers (a stag); without them it is a hind."
  },
  {
   "name": "antlerSize",
   "type": "number",
   "default": 1,
   "min": 0.35,
   "max": 1.5,
   "description": "Size of the antlers (0.35 a young stag or a roe buck, 1.5 a big wapiti)."
  },
  {
   "name": "tines",
   "type": "integer",
   "default": 4,
   "min": 2,
   "max": 6,
   "description": "Tines (points) along each beam."
  },
  {
   "name": "earSize",
   "type": "number",
   "default": 1,
   "min": 0.7,
   "max": 1.5,
   "description": "Ear size (1.5 a mule deer)."
  },
  {
   "name": "spots",
   "type": "boolean",
   "default": false,
   "min": 0,
   "max": 1,
   "description": "White spots on the back and flanks (a sika or fallow deer, or a fawn)."
  }

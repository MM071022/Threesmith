   "type": "number",
   "default": 0.89,
   "min": 0.7,
   "max": 1.0,
   "description": "Depth front to back."
  },
  {
   "name": "rows",
   "type": "integer",
   "default": 6,
   "min": 3,
   "max": 8,
   "description": "Product trays behind the glass."
  },
  {

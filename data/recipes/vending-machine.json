   "default": 0.99,
   "min": 0.75,
   "max": 1.3,
   "description": "Cabinet width in metres (39 in is the common snack machine)."
  },
  {
   "name": "height",
   "type": "number",
   "default": 1.83,
   "min": 1.6,
   "max": 2.0,
   "description": "Height to the top of the cabinet."
  },
  {

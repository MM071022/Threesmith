{
 "version": 1,
 "name": "horse-carriage",
 "archetype": "vehicle.wheeled.carriage",
 "description": "A horse-drawn coach for historic or fantasy scenes (the horse is not included): a curved, lacquered body on elliptic leaf springs with glazed doors, quarter and front windows, a black roof with a luggage rail, a driver's box with cushion, footboard and coach lamps, and a trunk at the rear; four wooden spoked wheels with iron tyres and brass caps, larger at the rear; a perch, a fifth wheel and a turning forecarriage with the front axle, splinter bar and two shafts for one horse. Open, it becomes a landau with benches and a folded hood; ornate, it gets gold mouldings, a crown, finials and gilded lamps.",
 "params": [
  {
   "name": "bodyLength",
   "type": "number",
   "default": 2.2,
   "min": 1.8,
   "max": 2.8,
   "description": "Length of the coach body in metres."
  },
  {
   "name": "width",
   "type": "number",
   "default": 1.35,
   "min": 1.2,
   "max": 1.6,
   "description": "Width of the body; the wheels stand outside it."
  },
  {
   "name": "rearWheelRadius",
   "type": "number",
   "default": 0.65,
   "min": 0.5,
   "max": 0.75,
   "description": "Radius of the rear wheels (1.3 m across is a typical coach wheel)."
  },
  {
   "name": "frontWheelRatio",
   "type": "number",
   "default": 0.74,
   "min": 0.6,
   "max": 0.9,
   "description": "Front wheel size as a part of the rear wheel size; the front wheels are smaller so they can turn under the body."
  },
  {
   "name": "closed",
   "type": "boolean",
   "default": true,
   "min": 0,
   "max": 1,
   "description": "A closed coach with roof, glazed doors and windows; open, it is a landau with a folded hood and the seats in view."
  },
  {
   "name": "ornate",
   "type": "boolean",
   "default": false,
   "min": 0,
   "max": 1,
   "description": "Fairy-tale trim: gold mouldings, a crown and finials on the roof and gilded lamps."
  },
  {
   "name": "shaftLength",
   "type": "number",
   "default": 2.6,
   "min": 2.0,
   "max": 3.2,
   "description": "Length of the shafts in front of the front axle (a horse stands between them)."
  },
  {
   "name": "steer",
   "type": "number",
   "default": 0,
   "min": -30,
   "max": 30,
   "description": "Turn of the front axle and shafts in degrees (positive turns left)."
  }
 ],

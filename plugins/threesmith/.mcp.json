{
  "mcpServers": {
    "threesmith": {
      "command": "npx",
      "args": [
        "-y",
        "threesmith@0.3.0",
        "mcp",
        "--tier",
        "premium"
      ],
      "env": {
        "THREESMITH_PROJECT": "${user_config.project}",
        "THREESMITH_PROTECT": "${user_config.protect}",
        "THREESMITH_TOOLS": "${user_config.tools}",
        "THREESMITH_READ_ONLY": "${user_config.read_only}"
      }
    }
  }
}
